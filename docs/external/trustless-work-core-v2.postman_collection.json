{
  "info": {
    "name": "Trustless Work Core API — v2 contract",
    "description": "Full endpoint surface with the v2 wire contract (2026-07-13): contractId as the only escrow identifier, camelCased snapshot, type/balance renames, topics+payload events, batch details, grants by contractId. Auth: set {{apiKey}} (x-api-key) or {{bearer}} (wallet-session JWT). See docs/BACKOFFICE-V2-CONTRACT-MIGRATION.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://trustless-core-production.up.railway.app" },
    { "key": "apiKey", "value": "keyid.keysecret" },
    { "key": "bearer", "value": "" },
    { "key": "contractId", "value": "CBLPXYESZJJDQSYDZC6HOCWU6DQP2SFZBAESVK3RTVK4DTU42HYUG5DT" },
    { "key": "platformId", "value": "1" },
    { "key": "userId", "value": "1" },
    { "key": "keyId", "value": "" },
    { "key": "address", "value": "GCALEBRF6OY6BTGPK6TAAEWCPOWYB7RVOAURCG7VARXKJGLGBMIHSGWB" }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "x-api-key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health (public)",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/bootstrap-admin (public, once)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"adminSecret\": \"<ADMIN_BOOTSTRAP_SECRET>\",\n  \"email\": \"ops@trustlesswork.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/bootstrap-admin", "host": ["{{baseUrl}}"], "path": ["auth", "bootstrap-admin"] }
          }
        },
        {
          "name": "POST /auth/register/challenge (operator key)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"address\": \"{{address}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register/challenge", "host": ["{{baseUrl}}"], "path": ["auth", "register", "challenge"] }
          }
        },
        {
          "name": "POST /auth/register/verify (operator key)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"address\": \"{{address}}\",\n  \"signedXdr\": \"<signed challenge XDR>\",\n  \"email\": \"user@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register/verify", "host": ["{{baseUrl}}"], "path": ["auth", "register", "verify"] },
            "description": "Creates User + verified wallet + default Platform (\"My Platform\") + first ESCROW_MANAGER key (platform-scoped). Response includes platformId."
          }
        },
        {
          "name": "POST /auth/session/challenge (operator key)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"address\": \"{{address}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/session/challenge", "host": ["{{baseUrl}}"], "path": ["auth", "session", "challenge"] }
          }
        },
        {
          "name": "POST /auth/session/verify (operator key) → Bearer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"address\": \"{{address}}\",\n  \"signedXdr\": \"<signed challenge XDR>\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/session/verify", "host": ["{{baseUrl}}"], "path": ["auth", "session", "verify"] },
            "description": "Returns { token, expiresAt }. Store token in {{bearer}}."
          }
        },
        {
          "name": "POST /auth/session/logout (bearer)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{bearer}}", "type": "string" }] },
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/session/logout", "host": ["{{baseUrl}}"], "path": ["auth", "session", "logout"] }
          }
        },
        {
          "name": "POST /auth/recover/challenge (operator key)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"address\": \"{{address}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/recover/challenge", "host": ["{{baseUrl}}"], "path": ["auth", "recover", "challenge"] }
          }
        },
        {
          "name": "POST /auth/recover/verify (operator key)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"address\": \"{{address}}\",\n  \"signedXdr\": \"<signed challenge XDR>\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/recover/verify", "host": ["{{baseUrl}}"], "path": ["auth", "recover", "verify"] }
          }
        }
      ]
    },
    {
      "name": "API Keys (self-service)",
      "item": [
        {
          "name": "GET /users/me/api-keys",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/users/me/api-keys", "host": ["{{baseUrl}}"], "path": ["users", "me", "api-keys"] } }
        },
        {
          "name": "POST /users/me/api-keys",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"integration key\",\n  \"platformId\": \"{{platformId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/me/api-keys", "host": ["{{baseUrl}}"], "path": ["users", "me", "api-keys"] },
            "description": "Always ESCROW_MANAGER and ALWAYS platform-scoped. platformId optional if the account owns exactly one platform; several platforms → 422 PLATFORM_REQUIRED."
          }
        },
        {
          "name": "POST /users/me/api-keys/:keyId/rotate",
          "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/users/me/api-keys/{{keyId}}/rotate", "host": ["{{baseUrl}}"], "path": ["users", "me", "api-keys", "{{keyId}}", "rotate"] } }
        },
        {
          "name": "PUT /users/me/api-keys/:keyId/revoke",
          "request": { "method": "PUT", "url": { "raw": "{{baseUrl}}/users/me/api-keys/{{keyId}}/revoke", "host": ["{{baseUrl}}"], "path": ["users", "me", "api-keys", "{{keyId}}", "revoke"] } }
        }
      ]
    },
    {
      "name": "API Keys (admin)",
      "item": [
        {
          "name": "POST /admin/api-keys",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"roles\": [\"ESCROW_MANAGER\"],\n  \"description\": \"issued by ops\",\n  \"platformId\": \"{{platformId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/admin/api-keys", "host": ["{{baseUrl}}"], "path": ["admin", "api-keys"] },
            "description": "If roles include ESCROW_MANAGER the key is platform-scoped (sole platform auto-resolves). Pure-operator keys (ADMIN/BACKOFFICE_ADMIN only) may omit platformId."
          }
        },
        {
          "name": "GET /admin/api-keys?limit=&offset=",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/api-keys?limit=20&offset=0", "host": ["{{baseUrl}}"], "path": ["admin", "api-keys"], "query": [{ "key": "limit", "value": "20" }, { "key": "offset", "value": "0" }] } }
        },
        {
          "name": "GET /admin/api-keys/user/:userId",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/admin/api-keys/user/{{userId}}", "host": ["{{baseUrl}}"], "path": ["admin", "api-keys", "user", "{{userId}}"] } }
        },
        {
          "name": "PUT /admin/api-keys/:keyId/roles",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"roles\": [\"ESCROW_MANAGER\", \"BACKOFFICE_ADMIN\"]\n}" },
            "url": { "raw": "{{baseUrl}}/admin/api-keys/{{keyId}}/roles", "host": ["{{baseUrl}}"], "path": ["admin", "api-keys", "{{keyId}}", "roles"] }
          }
        },
        {
          "name": "POST /admin/api-keys/cleanup-expired",
          "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/admin/api-keys/cleanup-expired", "host": ["{{baseUrl}}"], "path": ["admin", "api-keys", "cleanup-expired"] } }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "GET /users/me",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] } }
        },
        {
          "name": "POST /admin/users",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"new.user@example.com\",\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\"\n}" },
            "url": { "raw": "{{baseUrl}}/admin/users", "host": ["{{baseUrl}}"], "path": ["admin", "users"] },
            "description": "Admin-created users also get their default Platform automatically."
          }
        },
        {
          "name": "PUT /admin/users/:userId/roles",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"roles\": [\"BACKOFFICE_ADMIN\"]\n}" },
            "url": { "raw": "{{baseUrl}}/admin/users/{{userId}}/roles", "host": ["{{baseUrl}}"], "path": ["admin", "users", "{{userId}}", "roles"] }
          }
        }
      ]
    },
    {
      "name": "Platforms & Subjects",
      "item": [
        {
          "name": "POST /platforms",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Grant Fox\"\n}" },
            "url": { "raw": "{{baseUrl}}/platforms", "host": ["{{baseUrl}}"], "path": ["platforms"] }
          }
        },
        {
          "name": "GET /users/me/platforms",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/users/me/platforms", "host": ["{{baseUrl}}"], "path": ["users", "me", "platforms"] } }
        },
        {
          "name": "PATCH /platforms/:platformId",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"My Platform (renamed)\"\n}" },
            "url": { "raw": "{{baseUrl}}/platforms/{{platformId}}", "host": ["{{baseUrl}}"], "path": ["platforms", "{{platformId}}"] }
          }
        },
        {
          "name": "POST /platforms/:platformId/subjects",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"externalId\": \"customer-42\",\n  \"walletAddress\": \"{{address}}\",\n  \"label\": \"ACME Corp\",\n  \"metadata\": { \"tier\": \"gold\" }\n}" },
            "url": { "raw": "{{baseUrl}}/platforms/{{platformId}}/subjects", "host": ["{{baseUrl}}"], "path": ["platforms", "{{platformId}}", "subjects"] }
          }
        },
        {
          "name": "GET /platforms/:platformId/subjects",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/platforms/{{platformId}}/subjects", "host": ["{{baseUrl}}"], "path": ["platforms", "{{platformId}}", "subjects"] } }
        }
      ]
    },
    {
      "name": "Wallets",
      "item": [
        {
          "name": "POST /wallets/link/challenge",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"address\": \"{{address}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/wallets/link/challenge", "host": ["{{baseUrl}}"], "path": ["wallets", "link", "challenge"] }
          }
        },
        {
          "name": "POST /wallets/link/verify",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"address\": \"{{address}}\",\n  \"signedXdr\": \"<signed challenge XDR>\"\n}" },
            "url": { "raw": "{{baseUrl}}/wallets/link/verify", "host": ["{{baseUrl}}"], "path": ["wallets", "link", "verify"] }
          }
        },
        {
          "name": "GET /users/me/wallets",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/users/me/wallets", "host": ["{{baseUrl}}"], "path": ["users", "me", "wallets"] } }
        },
        {
          "name": "DELETE /users/me/wallets/:address",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/users/me/wallets/{{address}}", "host": ["{{baseUrl}}"], "path": ["users", "me", "wallets", "{{address}}"] } }
        }
      ]
    },
    {
      "name": "Escrow — deploy & operate (build → sign → send)",
      "item": [
        {
          "name": "POST /escrow/single-release/v2/deploy",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-TW-Subject", "value": "customer-42", "description": "optional: attribute to a platform end-user", "disabled": true },
              { "key": "X-TW-Platform", "value": "{{platformId}}", "description": "wallet sessions with SEVERAL platforms only", "disabled": true }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"signer\": \"{{address}}\",\n  \"engagementId\": \"ENG-12345\",\n  \"title\": \"Website redesign — Q2 2026\",\n  \"description\": \"Single-release escrow covering UI design and delivery.\",\n  \"amount\": \"10000000000\",\n  \"platformFee\": 100,\n  \"roles\": {\n    \"admin\": \"{{address}}\",\n    \"platform\": \"G...\",\n    \"receiver\": \"G...\",\n    \"approvers\": [\"G...\"],\n    \"releaseSigners\": [\"G...\"],\n    \"disputeResolvers\": [\"G...\"],\n    \"serviceProviders\": [\"G...\"],\n    \"observers\": []\n  },\n  \"milestones\": [\n    { \"description\": \"Phase 1 — UI design delivery\", \"approvalsTarget\": 1 }\n  ],\n  \"trustline\": { \"address\": \"CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA\" }\n}" },
            "url": { "raw": "{{baseUrl}}/escrow/single-release/v2/deploy", "host": ["{{baseUrl}}"], "path": ["escrow", "single-release", "v2", "deploy"] },
            "description": "Returns { unsignedXdr, txHash, contractId } — contractId is the predicted C… address. Attribution is mandatory and awaited: an unattributable deploy is refused. Check /docs for the exact per-variant fields (this body is representative)."
          }
        },
        {
          "name": "POST /escrow/multi-release/v2/deploy",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"signer\": \"{{address}}\",\n  \"engagementId\": \"ENG-67890\",\n  \"title\": \"Multi-phase product launch\",\n  \"description\": \"Each milestone releases its own amount.\",\n  \"platformFee\": 100,\n  \"roles\": { \"admin\": \"{{address}}\", \"platform\": \"G...\", \"approvers\": [\"G...\"], \"releaseSigners\": [\"G...\"], \"disputeResolvers\": [\"G...\"], \"serviceProviders\": [\"G...\"], \"observers\": [] },\n  \"milestones\": [\n    { \"description\": \"Phase 1\", \"amount\": \"2500000000\", \"receiver\": \"G...\", \"approvalsTarget\": 1 }\n  ],\n  \"trustline\": { \"address\": \"CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA\" }\n}" },
            "url": { "raw": "{{baseUrl}}/escrow/multi-release/v2/deploy", "host": ["{{baseUrl}}"], "path": ["escrow", "multi-release", "v2", "deploy"] },
            "description": "Representative body — check /docs for exact fields."
          }
        },
        {
          "name": "POST /escrow/single-release/v2/fund",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"signer\": \"{{address}}\",\n  \"contractId\": \"{{contractId}}\",\n  \"amount\": \"10000000000\"\n}" },
            "url": { "raw": "{{baseUrl}}/escrow/single-release/v2/fund", "host": ["{{baseUrl}}"], "path": ["escrow", "single-release", "v2", "fund"] },
            "description": "Every escrow ACTION has this same shape: POST { signer, contractId, ...params } → { unsignedXdr, txHash } → sign → /stellar/send-transaction. Other actions: approve-milestones, approve-and-release-milestones, change-milestone-status, dispute, release-funds, resolve-dispute, manage-milestones, extend-ttl, update (PUT), withdraw-remaining-funds."
          }
        },
        {
          "name": "POST /stellar/send-transaction",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"signedXdr\": \"<client-signed XDR>\"\n}" },
            "url": { "raw": "{{baseUrl}}/stellar/send-transaction", "host": ["{{baseUrl}}"], "path": ["stellar", "send-transaction"] },
            "description": "Factory deploy → { txHash, ledger, contractId, escrow } and the creator (createdByUserId/creatorAddress) is stamped on the read-model. Plain call → { txHash, ledger, code: STELLAR_TX_SUBMITTED }."
          }
        }
      ]
    },
    {
      "name": "Escrow — reads (v2 contract)",
      "item": [
        {
          "name": "GET /escrows (listing, snapshot per row)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/escrows?scope=mine&limit=20&sort=updatedAt&order=desc",
              "host": ["{{baseUrl}}"],
              "path": ["escrows"],
              "query": [
                { "key": "scope", "value": "mine", "description": "mine | all (403 under participant visibility)" },
                { "key": "limit", "value": "20", "description": "1–200" },
                { "key": "sort", "value": "updatedAt", "description": "createdAt | updatedAt" },
                { "key": "order", "value": "desc" },
                { "key": "status", "value": "active", "disabled": true },
                { "key": "contractType", "value": "single-release", "description": "filter name unchanged; response field is `type`", "disabled": true },
                { "key": "engagementId", "value": "ENG-12345", "disabled": true },
                { "key": "contractIds", "value": "{{contractId}}", "description": "repeatable, 1–50", "disabled": true },
                { "key": "participant", "value": "{{address}}", "disabled": true },
                { "key": "role", "value": "approver", "disabled": true },
                { "key": "platformId", "value": "{{platformId}}", "disabled": true },
                { "key": "subjectId", "value": "1", "disabled": true },
                { "key": "createdAfter", "value": "2026-01-01T00:00:00Z", "disabled": true },
                { "key": "createdBefore", "value": "2026-12-31T23:59:59Z", "disabled": true },
                { "key": "cursor", "value": "<nextCursor>", "disabled": true }
              ]
            },
            "description": "→ { data: EscrowSummary[], hasMore, nextCursor }. Rows: network, contractId, type, engagementId, status, totalAmount (multi only), lastLedgerSeq, createdAt, updatedAt, snapshot (camelCased). NO id, NO asset."
          }
        },
        {
          "name": "GET /escrows/details (NEW batch detail)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/escrows/details?contractIds={{contractId}}",
              "host": ["{{baseUrl}}"],
              "path": ["escrows", "details"],
              "query": [{ "key": "contractIds", "value": "{{contractId}}", "description": "repeatable, 1–50" }]
            },
            "description": "→ { data: [ { escrow (state + snapshot + authorship), deposits[] } ] }. No timeline (page it per escrow). Inaccessible/unknown ids silently absent."
          }
        },
        {
          "name": "GET /escrows/:contractId (detail)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/escrows/{{contractId}}", "host": ["{{baseUrl}}"], "path": ["escrows", "{{contractId}}"] },
            "description": "→ { escrow, events[], deposits[] } — NO participants (roles live in snapshot.roles). Events carry topics + payload. 404 = not found OR not yours."
          }
        },
        {
          "name": "GET /escrows/:contractId/events (timeline)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/escrows/{{contractId}}/events?limit=50&order=asc",
              "host": ["{{baseUrl}}"],
              "path": ["escrows", "{{contractId}}", "events"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "order", "value": "asc" },
                { "key": "cursor", "value": "<nextCursor>", "disabled": true }
              ]
            },
            "description": "Events: { kind, actor, ledgerSeq, txHash, ledgerClosedAt, topics[], payload }. No id, no data wrapper."
          }
        },
        {
          "name": "GET /escrows/:contractId/milestones",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/escrows/{{contractId}}/milestones", "host": ["{{baseUrl}}"], "path": ["escrows", "{{contractId}}", "milestones"] },
            "description": "→ { contractId, type, milestones[] } (camelCased entries)."
          }
        },
        {
          "name": "GET /escrows/milestones (batch)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/escrows/milestones?contractIds={{contractId}}",
              "host": ["{{baseUrl}}"],
              "path": ["escrows", "milestones"],
              "query": [{ "key": "contractIds", "value": "{{contractId}}", "description": "repeatable, 1–50" }]
            }
          }
        },
        {
          "name": "GET /escrows/financial (batch)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/escrows/financial?contractIds={{contractId}}",
              "host": ["{{baseUrl}}"],
              "path": ["escrows", "financial"],
              "query": [{ "key": "contractIds", "value": "{{contractId}}", "description": "repeatable, 1–50" }]
            },
            "description": "→ { data: [ { contractId, type, asset, platformFee, totalAmount, totalDeposited, totalReleased, pendingRelease, nextRelease, balance } ] }. `balance` (was balanceProjected) = deposited − released."
          }
        },
        {
          "name": "POST /graphql (same contract on the graph)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"query ($contractId: String!) { escrow(contractId: $contractId) { contractId type status totalAmount snapshot financial { totalDeposited balance } events(limit: 10) { data { kind topics payload } } deposits { fromAddress amount } } }\",\n  \"variables\": { \"contractId\": \"{{contractId}}\" }\n}" },
            "url": { "raw": "{{baseUrl}}/graphql", "host": ["{{baseUrl}}"], "path": ["graphql"] }
          }
        }
      ]
    },
    {
      "name": "Escrow — access grants (by contractId)",
      "item": [
        {
          "name": "POST /escrows/access-grants",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"granteeEmail\": \"partner@example.com\",\n  \"scope\": \"escrow\",\n  \"contractId\": \"{{contractId}}\",\n  \"expiresAt\": \"2026-12-31T23:59:59.000Z\"\n}" },
            "url": { "raw": "{{baseUrl}}/escrows/access-grants", "host": ["{{baseUrl}}"], "path": ["escrows", "access-grants"] },
            "description": "BREAKING: body takes contractId (C…), no longer escrowId UUID. scope=grantor shares ALL your escrows (omit contractId). Creator-or-admin only; 404 ESCROW_NOT_FOUND for unknown/inaccessible ids."
          }
        },
        {
          "name": "POST /escrows/access-grants/revoke",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"granteeEmail\": \"partner@example.com\",\n  \"scope\": \"escrow\",\n  \"contractId\": \"{{contractId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/escrows/access-grants/revoke", "host": ["{{baseUrl}}"], "path": ["escrows", "access-grants", "revoke"] },
            "description": "→ { revoked: n }. Idempotent."
          }
        }
      ]
    },
    {
      "name": "Admin — attribution maintenance",
      "item": [
        {
          "name": "POST /admin/attributions/reconcile",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/admin/attributions/reconcile", "host": ["{{baseUrl}}"], "path": ["admin", "attributions", "reconcile"] },
            "description": "Re-attaches pending notes whose escrow is already projected. → { attached, waiting }. Runs automatically every 5 min; endpoint for manual runs."
          }
        },
        {
          "name": "POST /admin/attributions/cleanup",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/admin/attributions/cleanup", "host": ["{{baseUrl}}"], "path": ["admin", "attributions", "cleanup"] },
            "description": "Expires orphan notes (deploys that never executed). → { expired }. Also scheduled."
          }
        }
      ]
    }
