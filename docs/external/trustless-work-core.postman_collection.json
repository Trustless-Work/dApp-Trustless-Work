{
  "info": {
    "name": "Trustless Work Core — GET & GraphQL",
    "_postman_id": "b1f6c9e2-0a4d-4c7e-9f21-7ac0e5d3a100",
    "description": "Endpoints de LECTURA del Core API (todos los GET + GraphQL de consulta) para conectar un backoffice. Auth por header x-api-key. Configura las variables `baseUrl` y `apiKey` en la colección. Guía completa: docs/backoffice-api-guide.es.md. También en Swagger: /docs/escrows-query (read-model), /docs/core (cuenta, platforms, subjects), y GraphQL SDL en docs/schema.graphql.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "x-api-key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "apiKey", "value": "", "type": "string" },
    { "key": "contractId", "value": "", "type": "string" },
    { "key": "platformId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "keyId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Escrows — Read-model (GET)",
      "description": "El read-model alimentado por el Indexer. Eventualmente consistente. Direccionado por contractId (C…). En Swagger: /docs/escrows-query.",
      "item": [
        {
          "name": "List escrows",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/escrows?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["escrows"],
              "query": [
                { "key": "limit", "value": "50", "description": "1–200, default 50" },
                { "key": "cursor", "value": "", "description": "nextCursor de la página previa", "disabled": true },
                { "key": "sort", "value": "updatedAt", "description": "createdAt | updatedAt (def updatedAt)", "disabled": true },
                { "key": "order", "value": "desc", "description": "asc | desc (def desc)", "disabled": true },
                { "key": "status", "value": "active", "description": "active | released | disputed", "disabled": true },
                { "key": "contractType", "value": "single-release", "description": "single-release | multi-release", "disabled": true },
                { "key": "engagementId", "value": "", "description": "id de engagement exacto", "disabled": true },
                { "key": "contractIds", "value": "", "description": "batch: repetir el param, ≤50", "disabled": true },
                { "key": "participant", "value": "", "description": "wallet G… que participa", "disabled": true },
                { "key": "role", "value": "approver", "description": "rol (snake_case); con participant = misma fila", "disabled": true },
                { "key": "platformId", "value": "", "description": "id numérico de plataforma", "disabled": true },
                { "key": "subjectId", "value": "", "description": "id numérico de subject", "disabled": true },
                { "key": "createdAfter", "value": "", "description": "ISO 8601 (desde)", "disabled": true },
                { "key": "createdBefore", "value": "", "description": "ISO 8601 (hasta)", "disabled": true }
              ]
            },
            "description": "Escrows accesibles por la credencial, filtrados y paginados (keyset). Respuesta: { data:[EscrowSummary], hasMore, nextCursor }."
          }
        },
        {
          "name": "Get escrow (detail)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/escrows/{{contractId}}",
              "host": ["{{baseUrl}}"],
              "path": ["escrows", "{{contractId}}"]
            },
            "description": "Estado completo + participantes + timeline (primeros 200) + depósitos. 404 ESCROW_NOT_FOUND si no existe o no es tuyo."
          }
        },
        {
          "name": "Get escrow milestones",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/escrows/{{contractId}}/milestones",
              "host": ["{{baseUrl}}"],
              "path": ["escrows", "{{contractId}}", "milestones"]
            },
            "description": "Solo el slice de milestones del estado. Shape según flavor. { contractId, contractType, milestones:[JSON] }."
          }
        },
        {
          "name": "Get escrow events (timeline)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/escrows/{{contractId}}/events?limit=50&order=asc",
              "host": ["{{baseUrl}}"],
              "path": ["escrows", "{{contractId}}", "events"],
              "query": [
                { "key": "limit", "value": "50", "description": "1–200, default 50" },
                { "key": "order", "value": "asc", "description": "asc (cronológico, def) | desc" },
                { "key": "cursor", "value": "", "description": "nextCursor de la página previa", "disabled": true }
              ]
            },
            "description": "Timeline paginado (keyset) por posición on-chain. { data:[EscrowEvent], hasMore, nextCursor }."
          }
        },
        {
          "name": "Batch milestones (by contractIds)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/escrows/milestones?contractIds={{contractId}}",
              "host": ["{{baseUrl}}"],
              "path": ["escrows", "milestones"],
              "query": [
                { "key": "contractIds", "value": "{{contractId}}", "description": "REQUERIDO. Repetir el param para varios (≤50)." }
              ]
            },
            "description": "Milestones de varios escrows en una request. Ids inaccesibles/desconocidos se omiten en silencio. { data:[{contractId,contractType,milestones}] }."
          }
        },
        {
          "name": "Batch financial (by contractIds)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/escrows/financial?contractIds={{contractId}}",
              "host": ["{{baseUrl}}"],
              "path": ["escrows", "financial"],
              "query": [
                { "key": "contractIds", "value": "{{contractId}}", "description": "REQUERIDO. Repetir el param para varios (≤50)." }
              ]
            },
            "description": "Cifras financieras PROYECTADAS (del read-model, no de la chain): fee, montos, depósitos, released/pending, balanceProjected. Eventualmente consistente."
          }
        }
      ]
    },
    {
      "name": "GraphQL (POST /graphql)",
      "description": "Consulta de escrows con selección de campos. Auth x-api-key. HTTP 200 siempre; errores en body.errors[].extensions.code.",
      "item": [
        {
          "name": "escrows (page + relations)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query MisEscrows($limit: Int, $role: String, $cursor: String) {\n  escrows(limit: $limit, role: $role, cursor: $cursor) {\n    data {\n      contractId\n      status\n      totalAmount\n      asset\n      participants { address role }\n      financial { balanceProjected pendingRelease nextRelease { amount } }\n    }\n    hasMore\n    nextCursor\n  }\n}",
                "variables": "{\n  \"limit\": 20,\n  \"role\": null,\n  \"cursor\": null\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Página de escrows con campos y relaciones elegidos. Filtros: status, contractType, engagementId, contractIds, participant, role, platformId, subjectId, createdAfter/Before, sort, order, limit, cursor."
          }
        },
        {
          "name": "escrow (one, by contractId)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query UnEscrow($contractId: String!) {\n  escrow(contractId: $contractId) {\n    contractId\n    status\n    totalAmount\n    asset\n    milestones\n    participants { address role milestoneIndex }\n    deposits { fromAddress amount asset }\n    financial { totalDeposited totalReleased pendingRelease balanceProjected }\n    events(limit: 50, order: desc) { data { kind actor ledgerSeq } hasMore nextCursor }\n  }\n}",
                "variables": "{\n  \"contractId\": \"{{contractId}}\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Un escrow con lo que necesites. Unknown/inaccesible → errors[].extensions.code = ESCROW_NOT_FOUND."
          }
        },
        {
          "name": "milestones only (minimal)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "{ escrow(contractId: \"{{contractId}}\") { milestones } }",
                "variables": "{}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": ["{{baseUrl}}"],
              "path": ["graphql"]
            },
            "description": "Ejemplo de field selection: solo milestones viajan."
          }
        }
      ]
    },
    {
      "name": "Cuenta e identidad (GET)",
      "description": "Self-service: cualquier credencial gestiona su propia cuenta. Paginación keyset {data,hasMore,nextCursor}.",
      "item": [
        {
          "name": "Get my user",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] },
            "description": "Tu cuenta: { id, email, firstName, lastName, isActive, emailVerified, roles[], createdAt, updatedAt }."
          }
        },
        {
          "name": "List my wallets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me/wallets?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "wallets"],
              "query": [
                { "key": "limit", "value": "50", "description": "1–200" },
                { "key": "cursor", "value": "", "disabled": true }
              ]
            },
            "description": "Tus wallets vinculadas (keyset)."
          }
        },
        {
          "name": "List my API keys",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me/api-keys?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "api-keys"],
              "query": [
                { "key": "limit", "value": "50", "description": "1–200" },
                { "key": "cursor", "value": "", "disabled": true }
              ]
            },
            "description": "Tus api-keys (sin el secret). Keyset."
          }
        },
        {
          "name": "List my platforms",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me/platforms?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "platforms"],
              "query": [
                { "key": "limit", "value": "50", "description": "1–200" },
                { "key": "cursor", "value": "", "disabled": true }
              ]
            },
            "description": "Tus plataformas (keyset). En Swagger: /docs/core."
          }
        },
        {
          "name": "List platform subjects",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/platforms/{{platformId}}/subjects?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["platforms", "{{platformId}}", "subjects"],
              "query": [
                { "key": "limit", "value": "50", "description": "1–200" },
                { "key": "cursor", "value": "", "disabled": true }
              ]
            },
            "description": "End-users (Subjects) de una plataforma tuya (keyset). En Swagger: /docs/core."
          }
        }
      ]
    },
    {
      "name": "Administración (GET) — ADMIN / BACKOFFICE_ADMIN",
      "description": "Requieren rol ADMIN o BACKOFFICE_ADMIN. Paginación offset {data,pagination:{limit,offset,total}}.",
      "item": [
        {
          "name": "List all users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/users?limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"],
              "query": [
                { "key": "limit", "value": "50", "description": "1–200, def 50" },
                { "key": "offset", "value": "0", "description": "def 0" }
              ]
            }
          }
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["admin", "users", "{{userId}}"] }
          }
        },
        {
          "name": "List all API keys",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/api-keys?limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "api-keys"],
              "query": [
                { "key": "limit", "value": "50", "description": "1–200, def 50" },
                { "key": "offset", "value": "0", "description": "def 0" }
              ]
            },
            "description": "Todas las api-keys del sistema (sin secrets)."
          }
        },
        {
          "name": "List API keys by user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/api-keys/user/{{userId}}?limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "api-keys", "user", "{{userId}}"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Get API key by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/api-keys/{{keyId}}", "host": ["{{baseUrl}}"], "path": ["admin", "api-keys", "{{keyId}}"] }
          }
        }
      ]
    },
    {
      "name": "Lecturas on-chain en vivo (GET)",
      "description": "Consultan la blockchain en vivo (RPC Soroban), NO el read-model. Úsalas para exactitud al instante. El shape está en Swagger (/docs/<flavor>/<version>).",
      "item": [
        {
          "name": "Get escrow — single-release v2 (live)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/escrow/single-release/v2/{{contractId}}", "host": ["{{baseUrl}}"], "path": ["escrow", "single-release", "v2", "{{contractId}}"] },
            "description": "Estado on-chain en vivo. También existen single-release/v1, multi-release/v1, multi-release/v2 (misma forma de ruta)."
          }
        },
        {
          "name": "Multiple balances — single-release v2 (live)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/escrow/single-release/v2/escrow-balances?addresses={{contractId}}",
              "host": ["{{baseUrl}}"],
              "path": ["escrow", "single-release", "v2", "escrow-balances"],
              "query": [
                { "key": "addresses", "value": "{{contractId}}", "description": "REQUERIDO. Repetir el param, hasta 20 direcciones C…" }
              ]
            },
            "description": "Balances on-chain de hasta 20 escrows. Existe para cada flavor/versión."
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check (público)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "noauth" },
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Liveness del servicio. No requiere credencial."
          }
        }
      ]
    }
  ]
}
